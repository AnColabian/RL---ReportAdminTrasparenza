<mvc:View controllerName="reportamministrazionetrasparenza.controller.History"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <mvc:dependents>
        <core:Fragment fragmentName="reportamministrazionetrasparenza.view.fragment.HistoryDetails" type="XML" />
    </mvc:dependents>
    <f:DynamicPage id="pageHistory" toggleHeaderOnTitleClick="false" busy="{historyViewModel>/busy}">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>storicoTitle}" />
                </f:heading>
                <f:actions>
                    <Button text="{i18n>backBtn}" icon="sap-icon://nav-back" press=".onNavigateBack" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox>
                        <Title text="{i18n>criteriSelezioneTitle}" level="H4" class="sapUiSmallMarginBottom" />
                        <HBox alignItems="End" wrap="Wrap">
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblDataStoricizzazioneDa}" labelFor="dpFilterDataDa" />
                                <DatePicker id="dpFilterDataDa" value="{historyViewModel>/filterDataStoricizzazioneFrom}" valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" width="12rem" change=".onHistoryFiltersChange" />
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblDataStoricizzazioneA}" labelFor="dpFilterDataA" />
                                <DatePicker id="dpFilterDataA" value="{historyViewModel>/filterDataStoricizzazioneTo}" valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" width="12rem" change=".onHistoryFiltersChange" />
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblUtente}" labelFor="cbFilterUtente" />
                                <ComboBox id="cbFilterUtente" selectedKey="{historyViewModel>/filterUtente}" items="{historyUsersModel>/results}" width="14rem" selectionChange=".onHistoryFiltersChange" change=".onHistoryFiltersChange">
                                    <core:Item key="{historyUsersModel>utente}" text="{historyUsersModel>utente}" />
                                </ComboBox>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <Button text="{i18n>historyResetFiltersBtn}" icon="sap-icon://clear-filter" press=".onResetHistoryFilters" />
                            </VBox>
                        </HBox>
                        <MessageStrip text="{i18n>msgHistoryServicesPending}" type="Information" showIcon="true" />
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table id="historyActionsTable" rows="{historyActionsModel>/results}" selectionMode="None" visibleRowCountMode="Auto" minAutoRowCount="10" rowHeight="32" noData="{i18n>msgHistoryActionsPending}">
                <t:extension>
                    <Toolbar>
                        <Title text="{i18n>historyActionsTitle}" level="H4" />
                    </Toolbar>
                </t:extension>
                <t:columns>
                    <t:Column width="12rem">
                        <Label text="{i18n>historyDateCol}" />
                        <t:template>
                            <Text text="{path: 'historyActionsModel>dataStorico', type: 'sap.ui.model.type.Date', formatOptions: {source: {pattern: 'yyyyMMdd'}, pattern: 'dd.MM.yyyy'}}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="{i18n>historyTimeCol}" />
                        <t:template>
                            <Text text="{historyActionsModel>oraStorico}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="14rem">
                        <Label text="{i18n>lblUtente}" />
                        <t:template>
                            <Text text="{historyActionsModel>utente}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="28rem">
                        <Label text="{i18n>historyFileNameCol}" />
                        <t:template>
                            <Text text="{historyActionsModel>nomeFile}" tooltip="{historyActionsModel>nomeFile}" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column width="7rem" hAlign="Center">
                        <Label text="{i18n>historyDetailsCol}" />
                        <t:template>
                            <Button icon="sap-icon://display" type="Emphasized" tooltip="{i18n>historyDetailsTooltip}" press=".onHistoryDetailsPress" />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>