<mvc:View controllerName="reportmef.controller.History"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:vm="sap.ui.comp.variants"
    xmlns:ctl="reportmef.control"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" displayBlock="true">
    <f:DynamicPage id="pageHistory" toggleHeaderOnTitleClick="false" busy="{historyViewModel>/busy}">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>storicoTitle}" />
                </f:heading>
                <f:actions>
                    <Button text="{i18n>backBtn}" icon="sap-icon://nav-back" press=".onNavigateBack" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox>
                        <Title text="{i18n>criteriSelezioneTitle}" level="H4" class="sapuiSmallMarginBottom" />
                        <l:HorizontalLayout allowWrapping="true">
                            <l:content>
                                <HBox alignItems="End" wrap="Wrap">
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblDataStoricizzazioneDa}" labelFor="dpFilterDataDa" />
                                        <DatePicker id="dpFilterDataDa" value="{historyViewModel>/filterDataStoricizzazioneFrom}" valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" width="12rem" />
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblDataStoricizzazioneA}" labelFor="dpFilterDataA" />
                                        <DatePicker id="dpFilterDataA" value="{historyViewModel>/filterDataStoricizzazioneTo}" valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" width="12rem" />
                                    </VBox>
                                    <!--  <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblUtente}" labelFor="miFilterUtente" />
                                        <MultiInput id="miFilterUtente" showValueHelp="true" valueHelpRequest=".onValueHelpUtente" width="12rem">
                                            <tokens>
                                            </tokens>
                                        </MultiInput>
                                    </VBox> -->
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblUnitaEconomica}" labelFor="miFilterUnitaEconomica" />
                                        <MultiInput id="miFilterUnitaEconomica" showValueHelp="true" valueHelpRequest=".onValueHelpUnitaEconomica" width="14rem">
                                            <tokens>
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblTipoOggetto}" labelFor="miFilterTipoOggetto" />
                                        <MultiInput id="miFilterTipoOggetto" showValueHelp="true" valueHelpRequest=".onValueHelpTipoOggetto" width="9rem">
                                            <tokens>
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblOggettoArchitettonico}" labelFor="miFilterOggettoArchitettonico" />
                                        <MultiInput id="miFilterOggettoArchitettonico" showValueHelp="true" valueHelpRequest=".onValueHelpOggettoArchitettonico" width="14rem">
                                            <tokens>
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox justifyContent="End" class="sapUiSmallMarginBottom">
                                        <Button text="{i18n>eseguiBtn}" type="Emphasized" press=".onExecute" />
                                    </VBox>
                                </HBox>
                            </l:content>
                        </l:HorizontalLayout>
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
         <ctl:P13nGridTable id="resultsTable" persistencyKey="HistoryTable" rows="{historyModel>/results}" selectionMode="MultiToggle" visibleRowCountMode="Auto" minAutoRowCount="10" rowHeight="32">       <ctl:extension>
                    <Toolbar id="resultsToolbar">
                        <Button id="btnExportSelection" text="{i18n>exportSelectionBtn}" icon="sap-icon://excel-attachment" type="Success" enabled="{historyViewModel>/exportEnabled}" press=".onExportSelection" />
                        <ToolbarSpacer />
                        <vm:VariantManagement id="vmHistory" showShare="false" showExecuteOnSelection="true" save=".onHistoryVariantSave" />
                        <Button id="btnP13n" icon="sap-icon://action-settings" type="Transparent" tooltip="{i18n>p13nBtnTooltip}" press=".onP13nPress" />
                    </Toolbar>
                </ctl:extension>
                <ctl:columns>
                    <!-- Colonne generate a runtime dal metadata di strfMef (ZRE_MEF_SRV) -->
                </ctl:columns>
            </ctl:P13nGridTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>