                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colSezioneUrbana}" />
                        <t:template>
                            <Text text="{historyModel>sezioneUrbana}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colSezioneAmministr}" />
                        <t:template>
                            <Text text="{historyModel>sezioneAmministr}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colParticellaCatasto}" />
                        <t:template>
                            <Text text="{historyModel>particellaCatasto}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="6rem">
                        <Label text="{i18n>colSub}" />
                        <t:template>
                            <Text text="{historyModel>sub}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colGraffMapSub}" />
                        <t:template>
                            <Text text="{historyModel>graffMapSub}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colDescrClasse}" />
                        <t:template>
                            <Text text="{historyModel>descrClasse}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colVariazioneDal}" />
                        <t:template>
                            <Text text="{historyModel>variazioneDal}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colVariazioneAl}" />
                        <t:template>
                            <Text text="{historyModel>variazioneAl}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colSuperficieMq}" />
                        <t:template>
                            <Text text="{historyModel>superficieMq}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colCubaturaMc}" />
                        <t:template>
                            <Text text="{historyModel>cubaturaMc}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colRendita}" />
                        <t:template>
                            <Text text="{historyModel>rendita}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colDataRivRend}" />
                        <t:template>
                            <Text text="{historyModel>dataRivRend}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colTipoDiCalcolo}" />
                        <t:template>
                            <Text text="{historyModel>tipoDiCalcolo}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colValOggArch}" />
                        <t:template>
                            <Text text="{historyModel>valOggArch}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colRedditoDominicale}" />
                        <t:template>
                            <Text text="{historyModel>redditoDominicale}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colRedditoAgrario}" />
                        <t:template>
                            <Text text="{historyModel>redditoAgrario}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="14rem">
                        <Label text="{i18n>colNote}" />
                        <t:template>
                            <Text text="{historyModel>note}" />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>