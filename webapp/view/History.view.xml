<mvc:View controllerName="reportamministrazionetrasparenza.controller.History"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core" displayBlock="true">
    <f:DynamicPage id="pageHistory" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>storicoTitle}" />
                </f:heading>
                <f:actions>
                    <Button text="{i18n>backBtn}" press=".onNavigateBack" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox>
                        <Title text="{i18n>criteriSelezioneTitle}" level="H4" class="sapuiSmallMarginBottom" />
                        <l:HorizontalLayout allowWrapping="true">
                            <l:content>
                                <HBox alignItems="End" wrap="Wrap">
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblDataStoricizzazione}" labelFor="drsFilterDataStoricizzazione" />
                                        <DateRangeSelection id="drsFilterDataStoricizzazione" dateValue="{historyViewModel>/filterDataStoricizzazioneFrom}" secondDateValue="{historyViewModel>/filterDataStoricizzazioneTo}" width="16rem" />
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblUtente}" labelFor="miFilterUtente" />
                                        <MultiInput id="miFilterUtente" showValueHelp="true" valueHelpRequest=".onValueHelpUtente" width="12rem">
                                            <tokens>
                                                <Token key="{historyViewModel>key}" text="{historyViewModel>text}" />
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox justifyContent="End" class="sapUiSmallMarginBottom">
                                        <Button text="{i18n>eseguiBtn}" type="Emphasized" press=".onExecute" />
                                    </VBox>
                                </HBox>
                            </l:content>
                        </l:HorizontalLayout>
                        <!--
                        <Title text="{i18n>layoutOutputTitle}" level="H4" class="sapuiSmallMarginTop sapuiSmallMarginBottom" />
                        <l:HorizontalLayout allowWrapping="true">
                            <l:content>
                                <HBox alignItems="End" wrap="Wrap">
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblVarianteLayout}" labelFor="ipFilterLayoutVariant" />
                                        <Input id="ipFilterLayoutVariant" value="{historyViewModel>/filterLayoutVariant}" width="12rem" />
                                    </VBox>
                                </HBox>
                            </l:content>
                        </l:HorizontalLayout>
                        -->
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table id="historyTable" rows="{historyModel>/results}" selectionMode="MultiToggle" enableSelectAll="true" rowSelectionChange=".onResultsSelectionChange" visibleRowCount="5">
                <t:extension>
                    <Toolbar id="historyToolbar">
                        <Title text="{i18n>storicoTitle}" level="H4" />
                        <ToolbarSpacer />
                        <Button id="btnExportHistorySelection" text="{i18n>exportSelectionBtn}" icon="sap-icon://excel-attachment" type="Success" enabled="{historyViewModel>/exportEnabled}" press=".onExportSelection" />
                    </Toolbar>
                </t:extension>
                <t:columns>
                    <t:Column width="6rem">
                        <Label text="{i18n>colSocieta}" />
                        <t:template>
                            <Text text="{historyModel>societa}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colUnitaEconomica}" />
                        <t:template>
                            <Text text="{historyModel>unitaEconomica}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="8rem">
                        <Label text="{i18n>colCompendio}" />
                        <t:template>
                            <Text text="{historyModel>compendio}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="{i18n>colDescrizTipoComp}" />
                        <t:template>
                            <Text text="{historyModel>descrizTipoComp}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDefinizioneUE}" />
                        <t:template>
                            <Text text="{historyModel>definizioneUE}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDescrBenePatrimoniale}" />
                        <t:template>
                            <Text text="{historyModel>descrBenePatrimoniale}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDescrNaturaGiuridica}" />
                        <t:template>
                            <Text text="{historyModel>descrNaturaGiuridica}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDescrTitoloUtilizzo}" />
                        <t:template>
                            <Text text="{historyModel>descrTitoloUtilizzo}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colVia}" />
                        <t:template>
                            <Text text="{historyModel>via}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="7rem">
                        <Label text="{i18n>colNumeroCivico}" />
                        <t:template>
                            <Text text="{historyModel>numeroCivico}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="6rem">
                        <Label text="{i18n>colCap}" />
                        <t:template>
                            <Text text="{historyModel>cap}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colLocalita}" />
                        <t:template>
                            <Text text="{historyModel>localita}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="6rem">
                        <Label text="{i18n>colRegione}" />
                        <t:template>
                            <Text text="{historyModel>regione}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colChiavePaesiRegioni}" />
                        <t:template>
                            <Text text="{historyModel>chiavePaesiRegioni}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="{i18n>colOggettoArchitett}" />
                        <t:template>
                            <Text text="{historyModel>oggettoArchitett}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colTipoOggArchitett}" />
                        <t:template>
                            <Text text="{historyModel>tipoOggArchitett}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="{i18n>colDefOggArch}" />
                        <t:template>
                            <Text text="{historyModel>defOggArch}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="8rem">
                        <Label text="{i18n>colFunzione}" />
                        <t:template>
                            <Text text="{historyModel>funzione}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colBusinessPartner}" />
                        <t:template>
                            <Text text="{historyModel>businessPartner}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDenominazioneDitta}" />
                        <t:template>
                            <Text text="{historyModel>denominazioneDitta}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDescrTpEdifTerr}" />
                        <t:template>
                            <Text text="{historyModel>descrTpEdifTerr}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colDescrBeneCulturale}" />
                        <t:template>
                            <Text text="{historyModel>descrBeneCulturale}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colIdCatCatastale}" />
                        <t:template>
                            <Text text="{historyModel>idCatCatastale}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colPercentRivalutaz}" />
                        <t:template>
                            <Text text="{historyModel>percentRivalutaz}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem" hAlign="End">
                        <Label text="{i18n>colCoeffRivalutaz}" />
                        <t:template>
                            <Text text="{historyModel>coeffRivalutaz}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem">
                        <Label text="{i18n>colNotaAddizionaleImmobile}" />
                        <t:template>
                            <Text text="{historyModel>notaAddizionaleImmobile}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="8rem">
                        <Label text="{i18n>colStAccatastam}" />
                        <t:template>
                            <Text text="{historyModel>stAccatastam}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="8rem">
                        <Label text="{i18n>colTipoCatasto}" />
                        <t:template>
                            <Text text="{historyModel>tipoCatasto}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colDenominatore}" />
                        <t:template>
                            <Text text="{historyModel>denominatore}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colTipoParticella}" />
                        <t:template>
                            <Text text="{historyModel>tipoParticella}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="{i18n>colCodComCatTav}" />
                        <t:template>
                            <Text text="{historyModel>codComCatTav}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="9rem">
                        <Label text="{i18n>colCodiceBelfiore}" />
                        <t:template>
                            <Text text="{historyModel>codiceBelfiore}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="7rem">
                        <Label text="{i18n>colFoglio}" />
                        <t:template>
