<mvc:View controllerName="reportamministrazionetrasparenza.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core" displayBlock="true">
    <f:DynamicPage id="pageWorklist" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>reportTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox>
                        <Toolbar id="filterToolbar">
                            <Title text="{i18n>criteriSelezioneTitle}" level="H4" />
                            <ToolbarSpacer />
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblSocieta}" labelFor="cbFilterSocieta" />
                                <ComboBox id="cbFilterSocieta" selectedKey="{viewModel>/filterSociety}" items="{societyModel>/societies}" width="9rem">
                                    <core:Item key="{societyModel>code}" text="{societyModel>text}" />
                                </ComboBox>
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblUnitaEconomica}" labelFor="miFilterUnitaEconomica" />
                                <MultiInput id="miFilterUnitaEconomica" tokens="{viewModel>/filterUnitaEconomica}" showValueHelp="true" valueHelpRequest=".onValueHelpUnitaEconomica" width="14rem" />
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblTipoOggetto}" labelFor="miFilterTipoOggetto" />
                                <MultiInput id="miFilterTipoOggetto" tokens="{viewModel>/filterTipoOggetto}" showValueHelp="true" valueHelpRequest=".onValueHelpTipoOggetto" width="9rem" />
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblOggettoArchitettonico}" labelFor="miFilterOggettoArchitettonico" />
                                <MultiInput id="miFilterOggettoArchitettonico" tokens="{viewModel>/filterOggettoArchitettonico}" showValueHelp="true" valueHelpRequest=".onValueHelpOggettoArchitettonico" width="14rem" />
                            </VBox>
                            <VBox justifyContent="End" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <CheckBox text="{i18n>lblTest}" selected="{viewModel>/filterTest}" />
                            </VBox>
                            <VBox justifyContent="End" class="sapUiSmallMarginBottom">
                                <Button text="{i18n>eseguiBtn}" type="Emphasized" press=".onExecute" />
                            </VBox>
                        </Toolbar>
                        <!--
                        <Toolbar id="layoutToolbar" class="sapUiSmallMarginTop">
                            <Title text="{i18n>layoutOutputTitle}" level="H4" />
                            <ToolbarSpacer />
                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="{i18n>lblVarianteLayout}" labelFor="inpFilterLayoutVariant" />
                                <Input id="inpFilterLayoutVariant" value="{viewModel>/filterLayoutVariant}" width="14rem" />
                            </VBox>
                        </Toolbar>
                        -->
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table id="resultsTable" rows="{reportModel>/results}" selectionMode="None" visibleRowCount="5">
                <t:columns />
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>