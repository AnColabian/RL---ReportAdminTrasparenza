<mvc:View controllerName="reportmef.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:ctl="reportmef.control"
    xmlns:vm="sap.ui.comp.variants"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" displayBlock="true">
    <f:DynamicPage id="pageWorklist" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>reportTitle}" />
                </f:heading>
                <f:actions>
                    <Button text="{i18n>storicoBtn}" press=".onNavigateToHistory" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox>
                        <Title text="{i18n>criteriSelezioneTitle}" level="H4" class="sapuiSmallMarginBottom" />
                        <l:HorizontalLayout allowWrapping="true">
                            <l:content>
                                <HBox alignItems="End" wrap="Wrap">
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblSocieta}" labelFor="cbFilterSocieta" />
                                        <ComboBox id="cbFilterSocieta" selectedKey="{viewModel>/filterSociety}" enabled="false" width="9rem">
                                            <core:Item key="1000" text="1000" />
                                        </ComboBox>
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblUnitaEconomica}" labelFor="miFilterUnitaEconomica" />
                                        <MultiInput id="miFilterUnitaEconomica" showValueHelp="true" valueHelpRequest=".onValueHelpUnitaEconomica" width="14rem">
                                            <tokens>
                                                <!--   <Token key="{viewModel>key}" text="{viewModel>text}" /> -->
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblTipoOggetto}" labelFor="miFilterTipoOggetto" />
                                        <MultiInput id="miFilterTipoOggetto" showValueHelp="true" valueHelpRequest=".onValueHelpTipoOggetto" width="9rem">
                                            <tokens>
                                                <!--   <Token key="{viewModel>key}" text="{viewModel>text}" /> -->
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <Label text="{i18n>lblOggettoArchitettonico}" labelFor="miFilterOggettoArchitettonico" />
                                        <MultiInput id="miFilterOggettoArchitettonico" showValueHelp="true" valueHelpRequest=".onValueHelpOggettoArchitettonico" width="14rem">
                                            <tokens>
                                                <!--   <Token key="{viewModel>key}" text="{viewModel>text}" /> -->
                                            </tokens>
                                        </MultiInput>
                                    </VBox>
                                    <VBox justifyContent="End" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <CheckBox text="{i18n>lblTest}" selected="{viewModel>/filterTest}" />
                                    </VBox>
                                    <VBox justifyContent="End" class="sapUiSmallMarginBottom">
                                        <Button text="{i18n>eseguiBtn}" type="Emphasized" press=".onExecute" />
                                    </VBox>
                                </HBox>
                            </l:content>
                        </l:HorizontalLayout>
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <ctl:P13nGridTable id="resultsTable" persistencyKey="WorklistTable" rows="{reportModel>/results}" selectionMode="MultiToggle" visibleRowCountMode="Auto" minAutoRowCount="10" rowHeight="32">
                <ctl:extension>
                    <OverflowToolbar>
                        <Title text="{i18n>resultTitle}" level="H4" />
                        <ToolbarSpacer />
                        <vm:VariantManagement id="vmWorklist" showShare="false" showExecuteOnSelection="true" save=".onVariantSave" />
                        <Button icon="sap-icon://action-settings" tooltip="{i18n>p13nBtnTooltip}" press=".onP13nPress" />
                    </OverflowToolbar>
                </ctl:extension>
                <ctl:columns>
                    <!-- Colonne generate a runtime dal metadata di strfMef (ZRE_MEF_SRV) -->
                </ctl:columns>
            </ctl:P13nGridTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>